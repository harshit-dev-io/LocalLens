# LocalLens V2 Environment Variables

# Google Gemini API Key (Gemini 2.5 Flash / Gemini 2.0 Flash)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Demo Coordinates (Defaults to Chandni Chowk Cultural Heritage Zone if not set)
VITE_DEMO_LAT=28.6506
VITE_DEMO_LNG=77.2309
